# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=EAAxxx
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-aleatoria-aqui

# Apps Script do dashboard (mesmo URL que o index.html usa)

# Lista de números autorizados (E.164, separados por vírgula)
# Ex: WHITELIST=5543999999999,5543988888888
WHITELIST=

# Pluggy (Open Finance) — integração bancária C6/Bradesco
# Pegar em: Pluggy Dashboard -> Configurações -> API Keys
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Asaas (asaas.com) — emissão de nota fiscal (NFS-e) + boleto/PIX
# Pegar em: Configurações -> Integrações -> API Key (uma chave sandbox, uma de produção)
ASAAS_API_KEY=
ASAAS_API_KEY_SANDBOX=

# Resend (resend.com) — envio do e-mail consolidado de notas (ex: Léo Cosméticos)
# Pegar em: Dashboard Resend -> API Keys. RESEND_FROM precisa ser um remetente
# verificado no domínio (ex: financeiro@agenciamgb.com.br via DNS na Resend).
RESEND_API_KEY=
RESEND_FROM=MGB Mídia <financeiro@agenciamgb.com.br>

# ── Segurança (11/2026): login do hub e segredos dos Apps Scripts ─────────────────────
# Login (ver lib/auth.js e scripts/gerar-usuarios.js)
HUB_AUTH_SECRET=
HUB_USERS=
# Origens que podem chamar a API pelo navegador (vírgula). Vazio = https://ederbalbino-hub.github.io
HUB_ORIGINS=

# Estado do hub no Supabase (projeto "MGB Hub"). A secret key fica SÓ aqui, nunca no navegador.
SUPABASE_URL=https://wvatjibxyhhbotayabig.supabase.co
SUPABASE_SECRET_KEY=
# Só para a importação única (banco vazio na 1ª leitura copia o estado do Apps Script antigo)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxxx/exec

# Faturamento (apps-script-faturamento/Code.gs). Segredo = Script Properties → FATURAMENTO_SECRET
FATURAMENTO_API_URL=https://script.google.com/macros/s/AKfycbxxx/exec
FATURAMENTO_SECRET=

# Assinafy (apps-script-assinafy/Code.gs). Segredo = Script Properties → GS_SECRET
ASSINAFY_GS_URL=https://script.google.com/macros/s/AKfycbxxx/exec
ASSINAFY_GS_SECRET=

# Plano de Caixa (implantação "Qualquer pessoa"). Token = Script Properties → TOKEN_SYNC_EMPRESA
PLANO_CAIXA_URL=https://script.google.com/macros/s/AKfycbxxx/exec
PLANO_CAIXA_TOKEN=
